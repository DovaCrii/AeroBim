ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('muro-minimo.ifc','2026-08-19T00:00:00',('AeroBim'),('AeroBim'),'AeroBim fixture','AeroBim','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
/* Fixture minimo para verificar el visor sin depender de un modelo de obra.
   Un muro de 4000 x 200 x 3000 unidades, con las unidades del modelo en MILIMETROS:
   el visor debe reportar 4,0 x 0,2 x 3,0 m. Si informara miles de metros, el pipeline
   no esta aplicando el factor de unidades del IFC, que es el error que este archivo
   existe para delatar. NO reemplaza al IFC real que exige F0.4 para medir rendimiento. */
#1= IFCPERSON($,'AeroBim',$,$,$,$,$,$);
#2= IFCORGANIZATION($,'AeroBim',$,$,$);
#3= IFCPERSONANDORGANIZATION(#1,#2,$);
#4= IFCAPPLICATION(#2,'0.1.0','AeroBim','AEROBIM');
#5= IFCOWNERHISTORY(#3,#4,$,.ADDED.,$,$,$,0);
#10= IFCCARTESIANPOINT((0.,0.,0.));
#11= IFCDIRECTION((0.,0.,1.));
#12= IFCDIRECTION((1.,0.,0.));
#13= IFCAXIS2PLACEMENT3D(#10,#11,#12);
#20= IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#21= IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#22= IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#23= IFCUNITASSIGNMENT((#20,#21,#22));
#30= IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#40= IFCPROJECT('0PROJECT00000000000000',#5,'AeroBim fixture',$,$,$,$,(#30),#23);
#50= IFCLOCALPLACEMENT($,#13);
#41= IFCSITE('0SITE00000000000000000',#5,'Sitio',$,$,#50,$,$,.ELEMENT.,$,$,$,$,$);
#51= IFCLOCALPLACEMENT(#50,#13);
#42= IFCBUILDING('0BUILDING0000000000000',#5,'Edificio',$,$,#51,$,$,.ELEMENT.,$,$,$);
#52= IFCLOCALPLACEMENT(#51,#13);
#43= IFCBUILDINGSTOREY('0STOREY000000000000000',#5,'Planta 1',$,$,#52,$,$,.ELEMENT.,0.);
#53= IFCLOCALPLACEMENT(#52,#13);
#60= IFCCARTESIANPOINT((0.,0.));
#61= IFCAXIS2PLACEMENT2D(#60,$);
#62= IFCRECTANGLEPROFILEDEF(.AREA.,'Muro',#61,4000.,200.);
#63= IFCEXTRUDEDAREASOLID(#62,#13,#11,3000.);
#64= IFCSHAPEREPRESENTATION(#30,'Body','SweptSolid',(#63));
#65= IFCPRODUCTDEFINITIONSHAPE($,$,(#64));
#70= IFCWALLSTANDARDCASE('0WALL00000000000000000',#5,'Muro de prueba',$,$,#53,#65,$);
#80= IFCRELAGGREGATES('0AGG100000000000000000',#5,$,$,#40,(#41));
#81= IFCRELAGGREGATES('0AGG200000000000000000',#5,$,$,#41,(#42));
#82= IFCRELAGGREGATES('0AGG300000000000000000',#5,$,$,#42,(#43));
#83= IFCRELCONTAINEDINSPATIALSTRUCTURE('0CONTAINED000000000000',#5,$,$,(#70),#43);
ENDSEC;
END-ISO-10303-21;
