# Copia esto a `.env` y cambia lo que haga falta. **El `.env` no se confirma.**
#
# `SECRET_KEY` tiene que ser aleatoria de verdad en produccion. AeroPlanner arrastro
# exactamente este problema —un secreto por defecto publicado en el codigo, con
# registro abierto— y aqui no se repite: `config/settings/base.py` la exige del
# entorno y solo `dev.py` pone una de desarrollo.
SECRET_KEY=cambiame-por-algo-aleatorio-de-verdad
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite por defecto; PostgreSQL cuando haya concurrencia real.
#
# **PostgreSQL necesita el grupo `deploy`**, que trae psycopg 3 y gunicorn:
# `uv sync --no-default-groups --group deploy`. Sin el, los ajustes fallan al cargar
# diciendo esto mismo — antes fallaba Django en la primera consulta, nombrando
# `psycopg2`, que es el paquete anterior y manda a instalar el que no es.
DB_ENGINE=sqlite3
# DB_ENGINE=postgres
# DB_NAME=aerobim
# DB_USER=aerobim
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Los documentos y los logs viven **fuera del repositorio**, bajo el control del
# operador, igual que los IFC y los planos.
DOCUMENTS_DIR=../../../aerobim-datos/documentos
LOGS_DIR=../../../aerobim-datos/logs

TIME_ZONE=America/Santiago
SITE_BASE_URL=http://localhost:8000

# El SPA del visor. Por defecto se sirve lo que construye `npm run build` en
# `apps/web/dist`, publicado bajo `/static/visor/` y **detras del login**.
# VISOR_DIST=../../apps/web/dist
#
# Mientras se trabaja en el SPA, apunta esto al servidor de Vite y `/visor/` redirige alli
# conservando `?revision=<uuid>`. **Vacio en produccion.**
# VISOR_DEV_URL=http://localhost:5173

# **Sin esto el correo se imprime en el log y la aplicacion diria que lo envio.**
# Ver `apps/core/mail.py`, que existe justamente por eso.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=aerobim@localhost

# Bloqueo por intentos en el formulario de ingreso.
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# La CSP arranca en modo informe; en produccion se aplica.
CSP_REPORT_ONLY=False

# **El conversor de DWG y DGN a DXF, que se instala A MANO y AeroBim no trae.**
#
# `ODA File Converter` es un ejecutable gratuito de la Open Design Alliance con su
# propia licencia: no se distribuye con el producto, no se descarga solo, y ningun
# paso del despliegue lo va a traer. Si nadie lo instala, no esta.
#
# Sin el, subir un DWG o un DGN SIGUE FUNCIONANDO —el archivo se guarda y se descarga
# igual— y lo unico que no ocurre es la conversion: esa revision no se puede abrir en
# el visor, y lo dice con su motivo.
#
# Ver `docs/DEPLOY.md` y `docs/FORMATOS.md`. Vacio = sin conversion.
# ODA_CONVERTER=/opt/oda/ODAFileConverter
